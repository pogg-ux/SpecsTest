  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">MWNP Field Assistant – rule-based agent driven by netlist.json</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.JsonAsset netlistAsset {"hint":"Job file: Assets/MWNP/netlist.json (the only source of circuit facts)"}'
    - '// @input AssignableType_1 cabinet {"hint":"Stand-in trainer model"}'
    - '// @input AssignableType_2 partTags {"hint":"Tags, labels and badges on the trainer"}'
    - '// @input AssignableType_3 safetyNotice {"hint":"Safety notice shown at start"}'
    - '// @input AssignableType_4 jobPanel {"hint":"Job panel / symptom list"}'
    - '// @input AssignableType_5 stepCard {"hint":"Step card with number pad"}'
    - '// @input AssignableType_6 findingCard {"hint":"Finding card"}'
    - '// @input AssignableType_7 summaryCard {"hint":"Job report (readings, finding, snapshots and photos)"}'
    - "// @input AssignableType_8 cameraCard {\"hint\":\"Camera card (opens in the step card's place)\"}"
    - '// @input AssignableType_9 schematicPanel {"hint":"Schematic panel above the step card"}'
    - '// @input Asset.AudioTrackAsset clickSfx {"hint":"Number pad / button click sound"}'
    - '// @input Asset.AudioTrackAsset passSfx {"hint":"Reading in spec sound"}'
    - '// @input Asset.AudioTrackAsset faultSfx {"hint":"Reading out of spec / unexplained sound"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input string simulatedFaultFunction = "EXTEND" {"hint":"Demo stand-in: which function is broken on the model (lamp stays off until repaired)", "widget":"combobox", "values":[{"label":"EXTEND", "value":"EXTEND"}, {"label":"RETRACT", "value":"RETRACT"}, {"label":"None", "value":""}]}'
    - '// @input string filesLoadedText = "Files loaded: wiring diagram, netlist" {"hint":"Files-loaded line on the Job panel"}'
    - "// @input string amberTemplate = \"{value} V doesn't match any fault in the job files. Recheck your meter leads and connection, then re-enter. I can't determine a cause from the files.\" {\"hint\":\"Amber (unexplained) message. {value} = reading in V\"}"
    - '// @input string fuseActionTemplate = "Lockout/tagout, remove {part}, check continuity, replace with {rating}. Do not upsize. If the new fuse blows, check {downstream} and {load} for a short." {"hint":"Next action for an open fuse. {part} {rating} {downstream} {load} come from netlist.json"}'
    - '// @input float summaryDelaySec = 1.5 {"hint":"Seconds the green retest result stays before the summary replaces the card", "widget":"slider", "min":0, "max":5, "step":0.1}'
    - '// @input float sfxVolume = 0.7 {"hint":"Sound effect volume", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - "// @input bool anchorToUserAtStart = true {\"hint\":\"At start, move the whole assistant so the authored layout sits relative to the user's head (heading only)\"}"
    - '// @input vec3 authoredEyePos = {0,0,18} {"hint":"Eye position the authored layout was designed around (cabinet 100 cm, cards 75 cm from here)"}'
    - '// @ui {"widget":"group_end"}'
