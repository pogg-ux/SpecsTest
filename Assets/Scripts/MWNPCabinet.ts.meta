  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">MWNP Trainer Cabinet – stand-in model built from primitives</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.RenderMesh boxMesh {"hint":"Unit box mesh used for every panel part"}'
    - '// @input Asset.RenderMesh sphereMesh {"hint":"Unit sphere mesh for lamps, holes and probe markers"}'
    - '// @input Asset.Material baseMaterial {"hint":"Unlit base material; cloned and tinted per part"}'
