    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input bool realisticLook = true {"hint":"Realistic industrial look: steel enclosure, DIN parts, round wires. Off = the original flat boxes."}'
    - "// @input float wireBodyAlpha = 0.7 {\"hint\":\"Realistic look: opacity of the round wire bodies that are not the current step's wire. 0.3 = the original dimmed rule (washed out); 0.7 keeps red / blue readable while the cyan focus wire still stands out.\", \"widget\":\"slider\", \"min\":0.3, \"max\":1, \"step\":0.05}"
