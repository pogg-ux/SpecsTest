        <!-- Notes -->
        <mxCell id="notes" value="&lt;b&gt;Operation&lt;/b&gt;&lt;br&gt;S1 UP = EXTEND (L1 on) · S1 DOWN = RETRACT (L2 on)&lt;br&gt;&lt;br&gt;&lt;b&gt;Test points&lt;/b&gt; (meter black lead on TS-2)&lt;br&gt;TS-1 = 12 V always · TS-4 = 12 V with S1 UP · TS-5 = 12 V with S1 DOWN&lt;br&gt;F1 out / L1(+) = 12 V with S1 UP if F1 and 2b/2c are good&lt;br&gt;&lt;br&gt;&lt;b&gt;Red&lt;/b&gt; = +12 VDC conductors · &lt;b&gt;Blue&lt;/b&gt; = 0 V return. TS-3 spare.&lt;br&gt;Supply current limit ~0.2 A during setup." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;strokeColor=#666666;fillColor=#f5f5f5;spacing=8;" vertex="1" parent="1">
