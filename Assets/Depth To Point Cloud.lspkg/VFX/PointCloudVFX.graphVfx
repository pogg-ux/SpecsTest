        Node3CheckValue: false
        Node4:
          DependencyIndex: 82
          LevelID: 45
          NodeCount: 0
          NodeType: 1
          Ports:
            Channels:
              ItemIndex: 5
              ItemList: "auto : xyzw : rgba : xyz : rgb : xy : x"
